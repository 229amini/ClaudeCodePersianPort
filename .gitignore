# Runtime state written by the app, not source. These hold real local folder
# paths from whoever ran it — keep them out of an open-source repo.
persian-claude-gui/recents.json
persian-claude-gui/archived.json
persian-claude-gui/pinned.json
persian-claude-gui/names.json

# Generated by setup.ps1 at install time.
persian-claude-gui/setup-log.txt
persian-claude-gui/run.vbs

# Offline install payload — the folder and its README are tracked so
# clean-machine-offline.wsb has something to map; the installers are not.
payload/*.exe

# Python
__pycache__/
*.pyc

# Windows
Thumbs.db
desktop.ini

# NOTE: static/fonts/*.woff2, static/vendor/marked.min.js and assets/icon.ico
# ARE committed on purpose. The target PC may be offline or locked down, so the
# project vendors them deliberately — do not add them here.

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# probe_v21.py's machine-readable dump. Regenerated on every run and specific to
# the machine and CLI build it ran on; the reviewed answers live in
# wiki/cli-stream-json-findings.md, which IS committed.
persian-claude-gui/probe_v21_findings.json
